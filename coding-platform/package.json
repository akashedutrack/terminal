{
  "name": "coding-platform",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "setup": "bash setup.sh",
    "server": "cd server && npm run dev",
    "client": "cd client && npm run dev",
    "dev": "concurrently -n SERVER,CLIENT -c blue,green \"npm run server\" \"npm run client\"",
    "seed": "cd server && node src/seed.js"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
